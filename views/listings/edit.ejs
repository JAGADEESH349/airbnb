<% layout("/layouts/boilerplate") %>

<div class="container mt-5 edit-page">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-12">

            <h2 class="mb-3">Edit <%= hotel.title %></h2>
            <h6 class="mb-3 text-muted">Fill details properly</h6>

            <form method="POST" action="/listings/<%= hotel._id %>?_method=PATCH" novalidate class="needs-validation" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input
                        type="text"
                        class="form-control" 
                        name="hotel[title]"
                        value="<%= hotel.title %>"
                        required>
                        <div class="valid-feedback">Title is valid.</div>
                        <div class="invalid-feedback">Please enter a valid title.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea
                        class="form-control"
                        name="hotel[description]"
                        rows="5"
                        required ><%= hotel.description %></textarea>
                        <div class="valid-feedback">Description is valid.</div>
                        <div class="invalid-feedback">Please enter a valid description.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Original Image </label>
                    <img src="<%=hotel.image.url%>" class="img-fluid rounded"
     style="height:300px; width:100%; object-fit:cover;">
                </div>
                <div class="mb-3">
                    <label class="form-label">Upload New Image</label>
                    <input
                        type="file"
                        class="form-control"
                        name="hotel[image]"
                        >
                        <div class="valid-feedback">Image File is valid.</div>
                        <div class="invalid-feedback">Please Upload a Valid Image File.</div>
                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Price</label>
                        <input
                            type="number"
                            class="form-control"
                            name="hotel[price]"
                            value="<%= hotel.price%>"
                            required>
                            <div class="valid-feedback">Price is valid.</div>
                            <div class="invalid-feedback">Please enter a valid price.</div>
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label">Country</label>
                        <input
                            type="text"
                            class="form-control"
                            name="hotel[country]"
                            value="<%= hotel.country %>"
                            required>
                            <div class="valid-feedback">Country is valid.</div>
                            <div class="invalid-feedback">Please enter a valid country.</div>
                    </div>

                </div>

                <div class="mb-3">
                    <label class="form-label">Location</label>
                    <input
                        type="text"
                        class="form-control"
                        name="hotel[location]"
                        value="<%= hotel.location %>"
                        required>
                        <div class="valid-feedback">Location is valid.</div>
                        <div class="invalid-feedback">Please enter a valid location.</div>
                </div>

                <button type="submit" class="btn btn-success me-2">
                    Update Details
                </button>

                <a href="/listings" class="btn btn-warning">
                    Back
                </a>

            </form>

        </div>
    </div>
</div>

